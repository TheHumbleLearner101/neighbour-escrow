# Crossmint client key (staging): https://staging.crossmint.com/console/projects/apiKeys
NEXT_PUBLIC_CROSSMINT_CLIENT_API_KEY=

# Deployed Campaigns contract and Circle USDC on Base Sepolia
NEXT_PUBLIC_CAMPAIGNS_ADDRESS=0x50729788eaEe25B1faF2680bcE87a147961F6A2e
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_EXPLORER=https://sepolia.basescan.org

# Vercel Blob, for campaign and proof photos (server-side only). Connecting a store on
# Vercel sets BLOB_STORE_ID; for local dev, use a read-write token instead.
BLOB_READ_WRITE_TOKEN=

# "Get $5 to try Hearth" button (server-side only, never NEXT_PUBLIC). Staging server
# key and signer secret from the Crossmint console; the code word is anything you like.
# Leave these empty and the button simply says test money isn't switched on.
CROSSMINT_SERVER_SIDE_API_KEY=
CROSSMINT_SIGNER_SECRET=
HEARTH_GIFT_CODE=
# Optional: dollars per account (default 5, max 10)
# HEARTH_GIFT_AMOUNT=5
