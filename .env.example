# Copy this file to .env and fill it in. Never commit .env.

# Network (Base Sepolia testnet only)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# Circle's USDC on Base Sepolia. Do not replace with any other address.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# A testnet-only wallet used to deploy the contract. Never use a wallet that holds real funds.
DEPLOYER_PRIVATE_KEY=

# Filled in after the contract is deployed
CAMPAIGNS_CONTRACT_ADDRESS=

# Crossmint: copy the variable names from your quickstart's own .env example
